{
  "name": "doori-messenger",
  "version": "1.0.0",
  "description": "Doori Messenger Local Dev Server",
  "scripts": {
    "dev": "npm run build && serve -p 3000 dist",
    "build": "node scripts/build-hosting.cjs",
    "test": "node --test tests/security.test.cjs tests/games.test.cjs tests/calls.test.cjs tests/assistant.test.cjs",
    "test:rules": "firebase emulators:exec --project demo-doori-security --only firestore \"node --test tests/firestore.test.cjs\"",
    "test:accounts": "firebase emulators:exec --project demo-doori-security --only firestore,auth \"node --test tests/accounts.test.cjs\"",
    "test:functions": "firebase emulators:exec --project demo-doori-security --only firestore,auth \"node --test tests/functions.test.cjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "jsdom": "^30.1.0",
    "serve": "^14.2.1"
  },
  "dependencies": {
    "agora-rtc-sdk-ng": "^4.24.8",
    "dompurify": "^3.4.15"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
